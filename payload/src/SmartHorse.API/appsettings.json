{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore.Update": "Debug",
      "Microsoft.EntityFrameworkCore.ChangeTracking": "Debug",
      "SmartHorse.Infrastructure.Persistence.Interceptors": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Update": "Debug",
        "Microsoft.EntityFrameworkCore.ChangeTracking": "Debug",
        "SmartHorse.Infrastructure.Persistence.Interceptors": "Information"
      }
    }
  },
  "Diagnostics": {
    "_comment": "TEMPORARY — Login DbUpdateConcurrencyException root-cause investigation. Set both to false and remove this section once resolved. Safe by default: verbose SQL/parameter logging (which includes password and refresh-token hashes) is OFF here and only turned on explicitly in appsettings.Development.json.",
    "EnableVerboseSqlLogging": false
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS01;Database=SmartHorseDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "SmartHorseApi",
    "Audience": "SmartHorseClients",
    "PrivateKeyPem": "",
    "PublicKeyPem": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": "System Administrator"
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "no-reply@smarthorse.local",
    "FromName": "Smart Horse Management System",
    "FrontendBaseUrl": "http://localhost:5173",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": ""
    },
    "SendGrid": {
      "ApiKey": ""
    }
  },
  "FileStorage": {
    "AvatarStoragePath": "wwwroot/avatars",
    "PublicBaseUrl": "/avatars",
    "MaxAvatarSizeBytes": 2097152
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "RootFolder": "smarthorse/horses"
  },
  "ImageValidation": {
    "MinFileSizeBytes": 1024,
    "MaxFileSizeBytes": 5242880,
    "MinWidthPixels": 200,
    "MinHeightPixels": 200,
    "MaxWidthPixels": 8000,
    "MaxHeightPixels": 8000
  }
}
